<resources>
  <style name="NtxTheme" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:colorAccent">@color/ntx_accent</item>
    <item name="android:windowBackground">@color/ntx_background</item>
    <item name="android:navigationBarColor">@color/ntx_background</item>
    <item name="android:statusBarColor">@color/ntx_background</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
    <item name="android:windowSplashScreenBackground">@color/ntx_background</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/ntx_mark</item>
    <item name="android:windowSplashScreenIconBackgroundColor">@color/launcher_plastic</item>
  </style>
</resources>
