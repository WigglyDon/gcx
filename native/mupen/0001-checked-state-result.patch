+/* NTX mechanical fallback for the optional frontend varargs logging ABI. */
+static void ntx_fallback_log(enum retro_log_level level, const char *format, ...)
+{
+    va_list args;
+    va_start(args, format);
+#ifdef ANDROID
+    const int priority = level >= RETRO_LOG_ERROR ? ANDROID_LOG_ERROR :
+                         level >= RETRO_LOG_WARN ? ANDROID_LOG_WARN :
+                         level >= RETRO_LOG_INFO ? ANDROID_LOG_INFO : ANDROID_LOG_DEBUG;
+    __android_log_vprint(priority, "ntx", format, args);
+#else
+    (void)level;
+    vfprintf(stderr, format, args);
+#endif
+    va_end(args);
+}
+
