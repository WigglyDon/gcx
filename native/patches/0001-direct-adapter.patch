+// Keep Android windows alive while queued or owned by an EGL/Vulkan surface.
+inline std::shared_ptr<void> AcquireRenderSurface(WindowSystemType type, void* handle)
+{
+#ifdef ANDROID
+  if (type == WindowSystemType::Android && handle)
+  {
+    ANativeWindow_acquire(static_cast<ANativeWindow*>(handle));
+    return {handle, [](void* value) { ANativeWindow_release(static_cast<ANativeWindow*>(value)); }};
+  }
+#endif
+  (void)type;
+  (void)handle;
+  return {};
+}
