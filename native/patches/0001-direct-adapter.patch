+bool MemoryCard::CommitSnapshot(bool force)
+{
+  std::lock_guard commit(m_commit_mutex);
+  if (!s_write_handler || m_read_failed || ExpansionInterface::ImageReadFailed())
+    return false;
+  if (!force && m_has_committed && !m_dirty.IsSet())
+    return true;
+  {
+    std::lock_guard snapshot(m_flush_mutex);
+    m_dirty.TestAndClear();
+    std::memcpy(m_flush_buffer.get(), m_memcard_data.get(), m_memory_card_size);
+  }
+  if (s_write_handler(m_filename, {m_flush_buffer.get(), m_memory_card_size}))
+  {
+    m_has_committed = true;
+    return true;
+  }
+  m_dirty.Set();
+  return false;
+}
