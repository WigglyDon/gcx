+// Modified for gcx, 2026-10-21. Installed before boot, cleared after flush-worker join.
+static MemoryCard::WriteHandler s_write_handler = nullptr;
+void MemoryCard::SetWriteHandler(WriteHandler handler) { s_write_handler = handler; }
+
+bool MemoryCard::FlushToStorage()
+{
+  std::lock_guard commit(m_commit_mutex);
+  if (!s_write_handler)
+    return false;
+  {
+    std::lock_guard snapshot(m_flush_mutex);
+    m_dirty.TestAndClear();
+    std::memcpy(m_flush_buffer.get(), m_memcard_data.get(), m_memory_card_size);
+  }
+  if (s_write_handler(m_filename, {m_flush_buffer.get(), m_memory_card_size}))
+    return true;
+  m_dirty.Set();
+  return false;
+}
+
